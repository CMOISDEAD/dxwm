# dunst config matching dxwm (src/config/mod.rs)
#
# install:
#   mkdir -p ~/.config/dunst && cp extra/dunstrc ~/.config/dunst/dunstrc
#   killall dunst
#
# The alert log sits in the bottom right corner, so notifications go top right.
# Pango can't use the X core font of the titles (misc-fixed), any monospace
# font close to it works.

[global]
    monitor = 0
    follow = keyboard

    # MARGIN from the monitor edges, like the clients and the alert log
    origin = top-right
    offset = (10, 10)
    # PROMPT_WIDTH, 80 columns
    width = (300, 580)
    height = (0, 200)
    notification_limit = 5
    indicate_hidden = yes

    # Stacked like the lines of the alert log
    gap_size = 0
    separator_height = 1
    separator_color = frame
    # LINE_PADDING / TITLE_PADDING
    padding = 3
    horizontal_padding = 6
    text_icon_padding = 6
    frame_width = 1
    frame_color = "#B8B6B2"
    corner_radius = 0

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 568
    progress_bar_corner_radius = 0

    font = Monospace 9
    line_height = 0
    markup = full
    # "21:49:03 WS     2" in the alerts, here "FIREFOX  summary"
    format = "<span foreground='#77756F'>%a</span>  <b>%s</b>\n%b"
    alignment = left
    vertical_alignment = top
    ellipsize = end
    ignore_newline = no
    word_wrap = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    show_age_threshold = 60

    icon_position = off
    sort = yes
    idle_threshold = 120

    sticky_history = yes
    history_length = 20

    dmenu = /usr/bin/dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#D7D5D1"
    foreground = "#77756F"
    frame_color = "#B8B6B2"
    highlight = "#77756F"
    timeout = 5

[urgency_normal]
    background = "#D7D5D1"
    foreground = "#222222"
    frame_color = "#B8B6B2"
    highlight = "#222222"
    timeout = 8

# Inverse video, like the selected prompt entry
[urgency_critical]
    background = "#222222"
    foreground = "#D7D5D1"
    frame_color = "#5C5C5C"
    highlight = "#D7D5D1"
    format = "<b>%a</b>  <b>%s</b>\n%b"
    timeout = 0
